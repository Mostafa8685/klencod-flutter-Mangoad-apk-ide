# Copy to .env and fill in. NEVER commit real values.
PORT=8080
PUBLIC_URL=https://api.your-domain.example
DATA_DIR=./data

# GitHub OAuth App (Device Flow enabled). Client secret is NOT needed for Device Flow.
GITHUB_CLIENT_ID=
GITHUB_OAUTH_SCOPE=read:user

# Dedicated PRIVATE build repository (owner/repo) and a fine-grained token limited to it
BUILD_REPO=your-org/mango-build
BUILD_REPO_TOKEN=
WORKFLOW_FILE=build-android.yml
WORKFLOW_REF=main

# 32 random bytes as 64 hex chars:  openssl rand -hex 32
ENCRYPTION_KEY=
# any long random string:           openssl rand -hex 32
SIGNING_SECRET=

MAX_ZIP_MB=200
RETENTION_HOURS=24
BUILD_TIMEOUT_MIN=40
MAX_PARALLEL_BUILDS=1
DOWNLOAD_LINK_TTL_SEC=300
